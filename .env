# Conexión MongoDB: sólo se usan la URI completa y el nombre de la base de datos.
# No hace falta definir usuario/contraseña por separado en la aplicación.

# URI correcta de Atlas: debe incluir usuario, contraseña y el símbolo @ antes del host.
# Reemplaza TU_CONTRASEÑA por la contraseña real del usuario de base de datos.
MONGO_URI="mongodb+srv://local:renaido@cluster0.g8e47zn.mongodb.net/?appName=Cluster0"
MONGO_DATABASE="escoba"

